# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Email (Resend)
# Get your API key at https://resend.com
# Leave blank to disable email sending
RESEND_API_KEY=""
# Sender email address (must be from a verified Resend domain)
RESEND_FROM_EMAIL="reservations@yourmotel.com"
# Operator/staff email to receive new booking alerts (optional)
RESEND_OPERATOR_EMAIL=""

# Cron Jobs
# Secret token that protects the cron endpoints from public access.
# Generate with: openssl rand -hex 32
# Must match the Authorization: Bearer header sent by your cron service.
# Leave blank to disable all cron endpoints (they return 503).
CRON_SECRET=""

# Elavon Converge Payment Processing
# Credentials are stored per-property in Settings → Payments, not here.
# Set to 'true' to use the Elavon demo environment (no real charges made).
ELAVON_DEMO="true"

# Channex.io Channel Manager
# Get your API key at https://channex.io → Profile → API Keys
# Leave blank to disable Channex sync (ARI calendar still works locally)
CHANNEX_API_KEY=""
# Optional: set a webhook secret in Channex dashboard for signature verification
CHANNEX_WEBHOOK_SECRET=""
# Set to 'true' to run in mock mode — ARI pushes are logged locally instead of
# hitting the real API. Use the /dev/channex page to inspect logs and fire test webhooks.
CHANNEX_MOCK="true"
